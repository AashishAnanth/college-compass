{
  "name": "college-compass",
  "version": "0.1.0",
  "private": true,
  "description": "What your Canvas grade actually means, and what you can afford to let up on.",
  "scripts": {
    "build": "webpack --mode production",
    "dev": "webpack --mode development --watch",
    "typecheck": "tsc --noEmit",
    "build:engine": "tsc -p tsconfig.engine.json && node -e \"require('fs').writeFileSync('build/package.json','{\\\"type\\\":\\\"module\\\"}')\"",
    "test": "npm run typecheck && npm run build:engine && node ../tests/parity.mjs",
    "build:demo": "DEMO=1 webpack --mode production",
    "dev:demo": "DEMO=1 webpack --mode development --watch",
    "rules": "node scripts/sync-rules.js",
    "prebuild": "npm run rules",
    "pretypecheck": "npm run rules",
    "prebuild:engine": "npm run rules"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.268",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "copy-webpack-plugin": "^14.0.0",
    "css-loader": "^7.1.2",
    "style-loader": "^4.0.0",
    "ts-loader": "^9.5.1",
    "typescript": "^5.5.4",
    "webpack": "^5.94.0",
    "webpack-cli": "^5.1.4"
  }
}
